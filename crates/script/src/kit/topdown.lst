-- A top-down walker: 8 directions (or 4), speeding up and slowing down
-- smoothly, never faster diagonally than straight. Put it on an entity
-- with a Collider2D ticked Character, which does the hard part (stopping
-- at walls and solid tiles, sliding along them, slipping round corners):
-- this only says where to go.
--
-- With usesInput on it reads the Move action (WASD, the arrow keys, a
-- controller's left stick). Turn it off to walk something from your own
-- code instead: set wanted to where it should head (an NPC, say, with
-- directions set to 4).

get "solis/physics":[moveCharacter];
fetch "solis/input":Input;
fetch "solis/project":Action;

component TopDownController {
    has {
        float speed = 4;
        float acceleration = 40;
        float deceleration = 60;
        int directions = 8;
        bool usesInput = true;
        vec3 wanted = [0, 0, 0];
        vec3 velocity = [0, 0, 0];
        vec3 facing = [0, -1, 0];
    }

    method update(float dt) {
        vec3 want = wanted;
        is usesInput? then {
            want = Input:axis(Action.Move);
        }
        -- Four directions: only the bigger of across and up counts, as
        -- far as the whole push went (a diagonal is as fast as straight).
        is directions == 4? then {
            float pushed = Maths:sqrt(want.x * want.x + want.y * want.y);
            is Maths:abs(want.x) >= Maths:abs(want.y)? then {
                is want.x > 0? then {
                    want = [pushed, 0, 0];
                } or {
                    want = [0 - pushed, 0, 0];
                }
            } or {
                is want.y > 0? then {
                    want = [0, pushed, 0];
                } or {
                    want = [0, 0 - pushed, 0];
                }
            }
        }
        -- Two keys at once, or a stick pushed into a corner, is never
        -- longer than one: diagonals go at the same speed as straight.
        float length = Maths:sqrt(want.x * want.x + want.y * want.y);
        is length > 1? then {
            want = want * (1 / length);
        }

        -- Towards the speed wanted, by at most acceleration (or, stopping,
        -- deceleration) metres a second, each second.
        vec3 target = [want.x * speed, want.y * speed, 0];
        vec3 change = target - velocity;
        float rate = acceleration;
        is target.x == 0 && target.y == 0? then {
            rate = deceleration;
        }
        float most = rate * dt;
        float far = Maths:sqrt(change.x * change.x + change.y * change.y);
        is far > most? then {
            change = change * (most / far);
        }
        velocity = velocity + change;

        -- The way it last walked, for its sprite to face.
        is want.x != 0 || want.y != 0? then {
            facing = [want.x, want.y, 0] * (1 / Maths:max(length, 0.0001));
        }

        moveCharacter(this, velocity * dt);
    }
}

pass TopDownController;
end
