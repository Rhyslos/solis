-- Four ready-made cameras. Put one on the entity with the Camera
-- component. Each reads the ready-made input actions (Edit > Input
-- actions…), so players can rebind them.

fetch "solis/input":Input;
fetch "solis/project":Action;
fetch "solis/physics":Physics;
fetch "solis/world":World;
fetch "solis/tiles":MapBounds;

-- Follows behind a character, turning with Look. A wall between them
-- pulls the camera in, so it never looks through walls. The wheel (Zoom)
-- changes the distance only with wheelZooms on.
component ThirdPersonCamera {
    has {
        entity target = nothing;
        float distance = 4;
        float height = 1.6;
        bool wheelZooms = false;
        float closest = 1.5;
        float farthest = 10;
        float lowest = -60;
        float highest = 70;
        float yaw = 0;
        float pitch = -15;
    }

    method update(float dt) {
        is target == nothing? then {
            return;
        }
        vec3 look = Input:axis(Action.Look);
        yaw = yaw - look.x;
        pitch = Maths:clamp(pitch + look.y, lowest, highest);
        is wheelZooms? then {
            distance = distance * Maths:power(0.85, Input:axis(Action.Zoom).y);
            distance = Maths:clamp(distance, closest, farthest);
        }
        -- Where the character will be after this tick, so the camera
        -- keeps up with it.
        vec3 pivot = target:position() + target:velocity() * dt + [0, 0, height];
        -- A camera looks along its -Z: tipped up 90 degrees it looks
        -- along +Y, then pitch and yaw turn it.
        rotation facing = [90 + pitch, 0, yaw];
        vec3 behind = facing * [0, 0, 1];
        float away = distance;
        float wall = Physics:castRay(pivot, behind, distance + 0.3).distance;
        is wall >= 0? then {
            away = Maths:max(Maths:min(away, wall - 0.3), 0.2);
        }
        moveTo(pivot + behind * away);
        turnTo(facing);
    }
}

-- Sees from a character's eyes, turning with Look. With turnsBody on,
-- the character turns with it (set the CharacterController's
-- facesWhereItWalks off).
component FirstPersonCamera {
    has {
        entity body = nothing;
        float eyes = 1.65;
        bool turnsBody = true;
        float lowest = -85;
        float highest = 85;
        float yaw = 0;
        float pitch = 0;
    }

    method update(float dt) {
        is body == nothing? then {
            return;
        }
        vec3 look = Input:axis(Action.Look);
        yaw = yaw - look.x;
        pitch = Maths:clamp(pitch + look.y, lowest, highest);
        moveTo(body:position() + body:velocity() * dt + [0, 0, eyes]);
        turnTo([90 + pitch, 0, yaw]);
        is turnsBody? then {
            body:turnTo([0, 0, yaw]);
        }
    }
}

-- Looks down on the map from above, as strategy games do. Pan moves it
-- (arrow keys, left stick), holding Drag (the middle mouse button) and
-- moving the mouse drags the map, Turn turns it (Alt + left and right
-- arrows, right stick), and Zoom goes up and down (wheel, Page Up and
-- Page Down, triggers).
component RtsCamera {
    has {
        vec3 focus = [0, 0, 0];
        float height = 30;
        float lowest = 8;
        float highest = 120;
        float tilt = 55;
        float panSpeed = 20;
        float turnSpeed = 90;
        float yaw = 0;
    }

    method update(float dt) {
        yaw = yaw - Input:axis(Action.Turn).x * turnSpeed * dt;
        height = height * Maths:power(0.88, Input:axis(Action.Zoom).y);
        height = Maths:clamp(height, lowest, highest);
        -- Higher up, it pans faster, so the map moves the same on screen.
        float scale = height / 30;
        rotation heading = [0, 0, yaw];
        vec3 pan = Input:axis(Action.Pan);
        focus = focus + heading * [pan.x, pan.y, 0] * panSpeed * scale * dt;
        is Input:held(Action.Drag)? then {
            vec3 drag = Input:axis(Action.Look);
            focus = focus - heading * [drag.x, drag.y, 0] * height * 0.01;
        }
        float down = Maths:clamp(tilt, 10, 90) * Maths.pi / 180;
        vec3 back = heading * [0, 0 - Maths:cos(down) / Maths:sin(down), 0] * height;
        moveTo(focus + back + [0, 0, height]);
        turnTo([90 - Maths:clamp(tilt, 10, 90), 0, yaw]);
    }
}

-- Follows a character in a 2D game, with no keys of its own. The
-- character can move inside the dead zone (how far from the middle,
-- across and up, in metres) before the camera follows; then it catches up
-- smoothly, taking about smoothing seconds (0: at once). With bounds set
-- to an entity showing a tile map, it never shows past the map's edges,
-- and a map smaller than the view stays in the middle.
component FollowCamera2D {
    has {
        entity target = nothing;
        entity bounds = nothing;
        vec3 deadZone = [1, 0.75, 0];
        float smoothing = 0.2;
        vec3 speed = [0, 0, 0];
    }

    method update(float dt) {
        is target == nothing? then {
            return;
        }
        vec3 here = position();
        -- Where the character will be after this tick, so the camera
        -- keeps up with it.
        vec3 aim = target:position() + target:velocity() * dt;
        float goalX = here.x;
        float goalY = here.y;
        is aim.x > here.x + deadZone.x? then {
            goalX = aim.x - deadZone.x;
        }
        is aim.x < here.x - deadZone.x? then {
            goalX = aim.x + deadZone.x;
        }
        is aim.y > here.y + deadZone.y? then {
            goalY = aim.y - deadZone.y;
        }
        is aim.y < here.y - deadZone.y? then {
            goalY = aim.y + deadZone.y;
        }
        vec3 goal = [goalX, goalY, here.z];
        vec3 next = goal;
        is smoothing > 0? then {
            -- A spring that's just stiff enough not to overshoot
            -- (critically damped), so it eases in and stops dead.
            float omega = 2 / smoothing;
            float x = omega * dt;
            float fade = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x);
            vec3 change = here - goal;
            vec3 pull = (speed + change * omega) * dt;
            speed = (speed - pull * omega) * fade;
            next = goal + (change + pull) * fade;
        }
        is bounds != nothing? then {
            MapBounds box = bounds:mapBounds();
            is box.found? then {
                vec3 half = World:viewSize() * 0.5;
                next = [within(next.x, box.low.x + half.x, box.high.x - half.x), within(next.y, box.low.y + half.y, box.high.y - half.y), here.z];
            }
        }
        moveTo([next.x, next.y, here.z]);
    }

    -- v kept between low and high; their middle when the room between
    -- them is less than nothing (a map smaller than the view).
    method float within(float v, float low, float high) {
        is low > high? then {
            return (low + high) / 2;
        }
        return Maths:clamp(v, low, high);
    }
}

pass ThirdPersonCamera, FirstPersonCamera, RtsCamera, FollowCamera2D;
end
