-- The pause menu, with the player's settings. Each button sends an event
-- to the Game entity's Pauser (in main.lst), which changes the setting:
-- screens read the game, and only game code changes it.
fetch "solis/screen":Ui;
fetch "solis/screens":Screens;
fetch "solis/window":Window;
fetch "main":[Resumed, BiggerText, Fullscreen, NextResolution, Quit];

assembly PauseMenu {
    view {
        vec3 size = Window:resolution();
        string full = "off";
        is Window:fullscreen()? then {
            full = "on";
        }
        stack [width fill, height fill, center, middle] {
            column [gap 14, pad 36, background gray9, round 12, center] {
                text "Paused" [size 44, bold, white];
                button "Resume" [width 360, size 24, blue] {
                    send Resumed() to Ui:entity();
                }
                button "Text size " + (Screens:textSize() * 100).int().text() + "%" [width 360, size 24] {
                    send BiggerText() to Ui:entity();
                }
                button "Fullscreen: " + full [width 360, size 24] {
                    send Fullscreen() to Ui:entity();
                }
                button "Resolution " + size.x.int().text() + " × " + size.y.int().text() [width 360, size 24] {
                    send NextResolution() to Ui:entity();
                }
                button "Quit" [width 360, size 24, hover:[background red7]] {
                    send Quit() to Ui:entity();
                }
            }
        }
    }
}

pass PauseMenu;
end
