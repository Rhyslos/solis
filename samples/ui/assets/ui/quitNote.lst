-- Shown once the pause menu's Quit is chosen: the game stays stopped.
assembly QuitNote {
    view {
        stack [width fill, height fill, center, middle] {
            column [gap 8, pad 28, background gray9, round 12, center] {
                text "Paused" [size 44, bold, white];
                text "You quit: press Stop to go back to editing." [size 22, white];
            }
        }
    }
}

pass QuitNote;
end
