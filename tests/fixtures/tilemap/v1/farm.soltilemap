-- A tile map. Written by Solis; safe to edit by hand.
-- Cells are in chunks of 32 by 32: each layer's rows of terrain codes (a space
-- for an empty cell), and the values of cells that aren't at their start,
-- each [x, y, value] within the chunk.
tilemap version 1;

tileset = "000000000002D";
size = [40, 36];

layer 0000000000001 {
    name = "Ground";
    over = false;
}

layer 0000000000002 {
    name = "Decoration";
    over = false;
}

layer 0000000000003 {
    name = "Above";
    over = true;
}

value 000000000000A {
    name = "crop";
    kind = "choice";
    options = ["wheat", "corn"];
}

value 000000000000B {
    name = "growth";
    kind = "number";
}

value 000000000000C {
    name = "watered";
    kind = "switch";
}

