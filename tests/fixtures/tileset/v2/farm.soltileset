-- A tileset. Written by Solis; safe to edit by hand.
-- Each terrain is something a tile map's cell can be: its name, the one character
-- a map file writes for it, its colour, and how its art is chosen (its kind).
-- Each piece is a tile of the picture filling one of a terrain's slots; each rule
-- a pattern of the cells around one, for a terrain of its own rules.
tileset version 2;

picture = "000000000001E";
tile = [16, 16];

terrain 0000000000001 {
    name = "grass";
    code = ".";
    colour = [0.31, 0.48, 0.23];
}

terrain 0000000000002 {
    name = "tilled";
    code = "t";
    colour = [0.42, 0.29, 0.18];
    kind = "16-tile";
}

terrain 0000000000003 {
    name = "water";
    code = "~";
    colour = [0.18, 0.37, 0.56];
    kind = "47-tile";
}

