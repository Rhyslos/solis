-- A tileset. Written by Solis; safe to edit by hand.
-- Each terrain is something a tile map's cell can be: its name, the one character
-- a map file writes for it, its colour, how its art is chosen (its kind), and
-- whether it's solid (nothing with a body passes into it).
-- Each piece is a tile of the picture filling one of a terrain's slots; each rule
-- a pattern of the cells around one, for a terrain of its own rules.
fetch "solis/data/tileset":[Tileset, Terrain, Piece, Rule];

lock int version = 4;
lock Tileset tileset = new Tileset { picture = "000000000001E", tile = [16, 16] };
lock Terrain array terrains = [
    new Terrain { id = "0000000000001", name = "grass", code = ".", colour = [0.31, 0.48, 0.23] },
    new Terrain { id = "0000000000002", name = "tilled", code = "t", colour = [0.42, 0.29, 0.18], kind = "16-tile" },
    new Terrain { id = "0000000000003", name = "water", code = "~", colour = [0.18, 0.37, 0.56], kind = "47-tile", solid = true },
    new Terrain { id = "0000000000004", name = "fence", code = "#", colour = [0.54, 0.48, 0.35], kind = "edges", solid = true },
    new Terrain { id = "0000000000005", name = "rocks", code = "r", colour = [0.5, 0.5, 0.5], kind = "rules", solid = true },
];
lock Piece array pieces = [
    new Piece { id = "0000000000035", terrain = "0000000000001", slot = 0, at = [0, 4], weight = 3.0 },
    new Piece { id = "0000000000036", terrain = "0000000000001", slot = 0, at = [1, 4] },
