    new Piece { id = "000000000003C", terrain = "0000000000002", slot = 7, at = [3, 1] },
    new Piece { id = "000000000003D", terrain = "0000000000002", slot = 8, at = [0, 2] },
    new Piece { id = "000000000003E", terrain = "0000000000002", slot = 10, at = [2, 2] },
    new Piece { id = "000000000003F", terrain = "0000000000002", slot = 11, at = [3, 2] },
    new Piece { id = "000000000003G", terrain = "0000000000002", slot = 12, at = [0, 3] },
