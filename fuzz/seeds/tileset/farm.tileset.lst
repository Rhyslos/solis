    new Piece { id = "000000000003Q", terrain = "0000000000004", slot = 2, at = [2, 5] },
    new Piece { id = "000000000003R", terrain = "0000000000004", slot = 3, at = [3, 5] },
    new Piece { id = "000000000003S", terrain = "0000000000004", slot = 4, at = [0, 6] },
    new Piece { id = "000000000003T", terrain = "0000000000004", slot = 5, at = [1, 6] },
