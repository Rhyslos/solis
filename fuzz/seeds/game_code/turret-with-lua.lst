-- The turret sample: Solis's first game, written in Lust, Lua and Rust.
-- A turret shoots at a drone. The drone has health (Lust, here), armour
-- (Rust, in armour.rs) and sparks (Lua, in sparks.lua): the three talk
-- to each other with the events below.

get "solis/world":[say];

-- What the components tell each other.
event Hit(entity by, float damage);
event Dented(int platesLeft);
event Destroyed();

-- Shoots at its target every so often, until its ammo runs out.
component Turret {
    has {
        entity target = nothing;
        int ammo = 12;
        float damage = 2.5;
        float cooldown = 0.5;
        float reload = 0;
    }

    method update(float dt) {
        reload = reload - dt;
        is reload <= 0 && ammo > 0? then {
            send Hit(me, damage) to target;
            ammo = ammo - 1;
            reload = cooldown;
            is ammo == 0? then {
                say("The turret is out of ammo.");
            }
        }
    }
}

-- Takes the hits, and says when it's destroyed.
component Health {
    has {
        float hp = 20;
    }

    on Hit(entity by, float damage) {
        is hp > 0? then {
            hp = hp - damage;
            is hp <= 0? then {
                send Destroyed() to me;
            }
        }
    }
}

pass Turret, Health;
end
-- Sparks, the drone's third component, written in Lua: it reacts to the
-- armour denting (Rust, in armour.rs) and to the drone being destroyed
-- (Health, in main.lst).

local Sparks = component("Sparks", {
    { "shown", "int", 0 },
})

function Sparks:on_Dented(platesLeft)
    self.shown = self.shown + 1
    solis.say("Sparks fly from " .. solis.nameOf(self.me) .. ": " .. platesLeft .. " armour plates left.")
end

function Sparks:on_Destroyed()
    solis.say(solis.nameOf(self.me) .. " is destroyed!")
    -- It drops to the ground.
    local at = solis.positionOf(self.me)
    solis.moveTo(self.me, vec3(at.x, at.y, 0))
end
