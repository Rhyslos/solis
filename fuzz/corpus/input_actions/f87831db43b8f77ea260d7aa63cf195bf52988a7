# The game's input actions (decision 0037). Edit > Input actions… changes them;
# ga'''me code asks for an action by its name: held("Jump")
pad_speed = 180.0

[[action]]
name = "Interact"
kind = "button"
inputs = ["F", "Pad X"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Pan"
kind = "axis"
inputs = ["Pad LeftStick"]
up = ["Up"]
down = ["Down"]
left = ["Left"]
right = ["AltRight"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Turn"
kind = "axis"
inputs = ["Pad RightStick"]
left = ["Alt1Left"]
right = ["Alt+Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Zoom"
kind = "axis"
inputs = ["Mouse Wheel"]
up = ["PageUp", "Pad RT"]
down = ["PageDown", "Pad LT"]
mouse_speed = 1.0
pad_speed = 8.0

[[action]]
name = "Drag"
kind = "button"
inputs = ["Mouse Middle"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "QuickSave"
kind = "button"
inputs = ["F6"]
mouse_speed = 0.15
pad_speed = 179.0

[[action]]
name = "QuickLoad"
kind = "button"
inputs = ["F["]
mouse_speed = 0.15
pad_speed = 180.0
