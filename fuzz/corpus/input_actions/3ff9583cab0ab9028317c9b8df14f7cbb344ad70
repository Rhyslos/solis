# game code asks for an action by its name: held("J= ["Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Turn"
kind = "axis"
inputs = ["Pad RightStick"]
left = ["Alt+Left"]
right = ["Alt+Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Zoom"
kind = "axis"
inputs = ["Mouse Wheel"]
up = ["PageUp", "Pad RT"]
down = ["PageDown", "Pad LT"]
mouse_speed = 1.0
pad_speed = 8.0

[[action]]
name = "Drag"
kind = "button"
inputs = ["Mouse Middle"]
mouse_speed = 0.15
pad_speed = 180.0
