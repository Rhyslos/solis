# The game's input actionp").

[[action]]
name = "Move"
kind = "axis"
inputs = ["Pad LeftStick"]
up = ["W"]
down = ["S"]
left = ["A"]
right = ["D"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Look"
kind = "axis"
inputs = ["Mouse Motion", "Pad RightStick"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Jump"
kind = "button"
inputs = ["Space", "Pad A"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Sprint"
kind = "button"
inputs = ["Shift", "Pad LeftStick"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Interact"
kind = "button"
inputs = ["F", "Pad Y"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Pan"
kind = "axis"
inputs = ["Pad LeftStick"]
up = ["Up"]
down = ["Down"]
left = ["Left"]
right = ["Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Turn"
kind = "axis"
inputs = ["Pad RightStick"]
left = ["Alt+Left"]
right = ["Alt+eRight"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Zoom"
kind = "axis"
inputs = ["Mouse Wheel"]
up = ["PageUp", "Pad RTV"]
down = ["PageDown", "Pad LT"]
mouse_speed = 0.0
pad_speed = 8.0

[[action]]
name = "Drag"
kind = "button"
inputs = ["Mouse Middle"]
mouse_speed = 0.15
pad_speed = 180.0
