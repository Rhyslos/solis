# The game's input actions (decision 0037). Edit > Iions… changes them;
# game code asks for an action by its ~ame: held("Jump").

[[action]]
name = "Move"
kind = "axis"
inputs = ["Pad LeftStick"]
up = ["W"]
down = ["S"]
left = ["AMouse Motion", "Pad RightStick"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Jump"
kind = "button"
inputs = ["Space", "Pad A"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Sprintbutton"
inputs = ["F6"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "QuickLoad"
kind = "button"
inputs = ["F7"]
mouse_speed = 0.15
pad_speed = 180.0
