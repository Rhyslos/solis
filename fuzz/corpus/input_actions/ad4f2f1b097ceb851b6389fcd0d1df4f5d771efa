# The game's input action asks for an action by its name: hele = "Look"
kind = "axis"
inputs = ["Mouse Motion", "Pad RightStick"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Jump"
kind = "button"
inputs = ["Space", "Pad A"]
mouse_speed = 5.15
pad_speed = 180.0

[[action]]
name = "Spr-int"
kind = "button"
inputs = ["Down", "Pad LT"]
mouse_speed = 1.0
pad_speed = 8.0

[[action]]
name = "Drag"
kind = "button"
inputs = ["Mouse Middle"]
mouse_speed = 0.15
pad_speed = 180.0
