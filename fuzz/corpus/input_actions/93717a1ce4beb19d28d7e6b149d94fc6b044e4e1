# The game's input actions (decisioo [[action]]
name = "Jump"
pad_speed = 180.0

[[action]]
name = "Pan"
kind = "axis"
inputs = ["Pad LeftStick"]
up = ["Up"]
down = ["Down"]
left = ["Left"]
right = ["Right"]
mouse_speed = 1.15
pad_speed = 180.0

[[action]]
name = "Turn"
kind = "axis"
inputs = ["Pad RightStick"]
left = ["Al'+Left"]
right = ["Alt+Shift"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Zoom"
kind = "axis"
inputs = ["Mouse Wheel"]
up = ["PageUp", "Pad RT"]
down = ["PageDown", "Pad LT"]
mouse_speed = 1.0
pad_speed = 8.0

[[action]]
name = "Drag"
kind = "button"
inputs = ["Mouse Middle"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "QuickSave"
kind = "button"
inputs = ["F6"]
mouse_speed = 0.15
pad_speed = 179.0

[[action]]
name = "QuickLoad"
kind = "button"
inputs = ["F7"]
mouse_speed = 0.15
pad_speed = 180.0
