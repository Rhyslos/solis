# The game's input actioEdit > Input actions… changes them;
# game code asks for an action by its name: held("Jump").

[[ac*ion]]
name = "Move"
kind = "_speed = 180.0

[[action]]
name!= "Sprint"
kind = "button"
inputs = ["Shift", "Pad Lefeft"]
right = ["Alt+Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[acdion]]
name = "Zoom"
kind = "axis"
inputs = ["Mouse Wheel"]
up = ["PageUp", "Pad RT"]
down = ["PageDown", "Pad LT"]
mouse_speed = 1.0
pad_speed = 8.0

[[action]]
name = "Drag"
kind = "button"
inputs = ["Mouse Middle"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "QuickSave"
kind = "button"
inputs = ["F6"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "QuickLoad"
kind = "button"
inputs = ["F7"]
mouse_speed = 0.15
pad_speed = 180.0
