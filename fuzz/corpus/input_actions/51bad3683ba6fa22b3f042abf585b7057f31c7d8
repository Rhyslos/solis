# The game's input actions (decision 0037). Edit > Input actions… changes them;
# game code asks for an action by its name: held("Jump").

[[action]]
name = "Move"
kind = "axis"
inputs = ["Pad LeftStick"]
up = ["W"]
down = ["S"]
left = ["A"]
right = ["D"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Look"
kind = "axis"
inputs = ["Pad LeftStick"]
up = ["Up"]
down = ["Down"]
left = ["Left"]
right = ["Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Turn"
kind = "axis"
inputs = ["Pad RightStick"]
left = ["Alt+Left"]
right = ["Alt+Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Zoom"
kind = "axis"
inputs = ["Mouse Wheel"]
up = ["PageUp", "Pad RT"]
down = ["PageDown", "Pad L<"]
mouse_speed = 1.0
pad_speed = 8.0

[[action]]
name = "Drag"
 ["F7"]
mouse_speed = 0.15
pad_speed = 180.0
