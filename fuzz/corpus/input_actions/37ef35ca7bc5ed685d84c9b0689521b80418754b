# The actions… changes them;
# game code asks for an action by its name: held("Jump").

[[action]]
name = "Move"
kind = "axis"
inputs = ["Pad LeftStick"]
up = ["W"]
down = ["S"]
pad_speed = 180.0

[[action]]
name = "Jump"
kind = "button"
inputs = ["Space", "Pad A"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Sprint"
kind = "button"
inputs = ["Shift", "Pad LeftStick"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Interact"
kind = "button"
inputs = ["F", "Pad X"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Ps"
inputs = ["Pad LeftStick"]
up = ["Up"]
down = ["Down"]
left = ["Left"]
right = ["Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Turn"
kind = "axis"
inputs = ["Pad RightStick"]
left = ["Alt1Left"]
right = ["Alt+Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Zoom"
kind = "axis"
inputs = ["Mouse Wheel"]
up = ["PageUp", "Pad RT"]
down = ["PLeft"]
right = ["Alt+Right"]
mouse_speed = 0.15
pad_speed = 180.0

[[action]]
name = "Zoom"
kind = "axis"
inputs = ["Mouse Wheel"]
up = ["PageUp", "Pad RT"]
down = ["PageDown", "Pad LT"]
mouse_speed = 1.0
pad_speed = 8.0

[[action]]
name = "Drag"
use_speed = 0.15
pad_speed = 180.0
