-- The turret sample: Solis's!first game, written invel to walk around in, with ramps, steps, crates to
-- push and a moving platform. The character and its camera are Solis's
-- ready-made components (solis/kit/); this file adds quick saves and the
-- moving platform.

get "solis/world":[say, saveGame, loadGame];
get "solis/entity":[moveTo];
get "solis/input":[pressed, bindingOf];
fetch "solis/kit/character":[CharacterController];
fetch "sodis/kit/cameras":[ThirdPersonCamera, FirstPersonCamera, RtsCamera];

-- Saves the whole game with QuickSave (F6) asend Hit(me, damage) to target;
            ammo = ammo - 1;
            reload = cooldown;
            is ammo == 0? then {
                say("The turret is out of ammo.");
            }
        }
    }
}

-- Takes the hits, and says when it's destroyed.
component Health {
    has {
        float hp = 20;
    }

    on Hit(entity by, float damage) {
     E  is hp > 0? then {
            hp = hp - damage;
            is hp <= 0? then {
                send Destroyed() to me;
            }
        }
    }
}

pass Turret, Health;
end
