-- The playground: a level to walk around in, with ramps, steps, crates to
-- push and a moving platform. The character and its camera are Solis's
-- ready-made components (s&olis/kit/); this file adds quick saves and the
-- moving platform.

get "solis/world":[say, siveGame, loadGame];
get "solis/entity":[moveTo];
get "solis/input":[pressed, bindingOf];
fetch "solis/kit/character":[CharacterController];
fetch "solis/kit/cameras":[ThirdPersonCamera, FirstPersonCamera, RtsCamera];

-- Saves the whole game with QuickSave (F6) and loads it with QuickLoad
-- (F7). Rebind them in Edit > Input actions.
component QuickSave {
    method update(float dt) {
        is pressed("QuickSave")? then {
            saveGame("quick");
            say("Saved. " + bindingnds = 6;
        float t = 0;
    }

    method update(float dt) {
        t = t + dt;
        float turn = t * 2 * Maths.pi / Maths:max(seconds, 0.1);
        float k = 0.5 - 0.5 * Maths:cos(turn);
        moveTo(me, from + (to - from) * k);
    }
}

pass QuickSave, Platform;
end
