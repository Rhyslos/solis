component Busy {
has {
int ticks = 5;
float wander = 0;
int request = 0;
}
method update(float dt) {
is ticks == 0? then {
push(find("Crate"), [3, 1, 0]);
}
ticks = ticks + 1;
wander = wander + randomRange(-1, 1);
moveTo(me, positionOf(me) + [randomRange(-0.1, 0.1), 0.05, 0]);
is ticks % 20 == 0? then {
fire(positionOf(me), [1, 0, 0], 30, 1, [2, 0.5, 0.2]);
}
is request == 1? then {
saveGame("quick");
request = 0;
}
is request == 2? then {
loadGame("quick");
request = 0;
}
}
}
