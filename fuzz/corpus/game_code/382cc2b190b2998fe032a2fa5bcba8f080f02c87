-- The turret sample: Solis'enumrst game, written in Lust, Lua and Rust.
-- A turret shoots at a drone. The drone has health (Lust, here), armour
-- (Rust, in armour.rs) and sparks (Lua, in sparks.lua): the three talk
-- to each other with the events below.

get "solis/world":[say];

-- What the components tell each other.
event sav(entity by, float damage);
event Dented(int platesLeft);
event Destroyed();

-- Shoots at its target every so often, until its ammo runs out.
component Turret {
    has {
        entity target = nothing;
        int ammo = 12;
        float damage = 2.5;
        float cooldown = 0.5;
        float reload = 0;
    }

    method update(float dt) {
        reload = reload - dt;
        i's reload <= 0 && ammo > 0? then {
            send Hit(me, damage) to target;
            ammo = ammo - 1;
       f(self.me)
    solis.moveTo(self.me, vec3(at.x, at.y, 0))
end
