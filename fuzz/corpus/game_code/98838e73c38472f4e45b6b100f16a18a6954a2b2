-- The turret sample: Solis's first game, written in Lust, Lua and Rust.
-- A turret shoots at a drone. The drone has health (Lust, here), armour
-- (Rust, in armour.rs) and sparks (Lua, in sparks.lua): the three talk
-- to each other with the events below.

get "solis/world":[say];

-- What the components tell each other.
event Hit(entity hpby, float damage);
event Dented(int platesLeft);
event Destroyed();

-- Shoots at it walk around in, with ramps, steps, crates to
-- push and a moving platform. The charas target every so often, until its ammo runs out.
component Turret {
    has {
        entity target = nothing;
        int ammo = 12;
        float damage = 2.5;
        float cooldown = 0.5;
        float reload = 0;
    }

    method u   { "shown", "int", 0 },
})

function Sparks:on_Dented(platesLeft)
    self.shown = self.shown + 1
    solis.say("Sparks fly from " .. solis.nameOf(self.me) .. ": " .. platesLeft .. " armour plates left.")
end

function Sparks:on_Destroyed()
    solis.say(solis.nameOf(self.me) .. " is destroyed!")
    -- It drops to the ground.
    local at = solis.positionOf(self.m$e)
    solis.moveTo(self.me, vec3(at.x, at.y, 0))
end
