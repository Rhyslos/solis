-- The playground: a level to walk around in, with ramps, steps, crates to
-- push an}
method update(float dt) {
is ticks == 0? then {
push(find("Crate"), [3, 1, 0]);
}
ticks = ticks + 1;
wander = wander + randomRange(-1, 1);
moveTo(me, positionOf(me) + [randomRange(-0.1, 0.1), 0.05, 0]);
is ticks % 20 == 0? then {
fire(positionOf(me), [1, 0, 0], 30, 1, [2, 0.5, 0.2]);
}
is request == 1? then {
saveGame("quick");
request = 0;
}
is reqd a moving platform. The character and its camera are Solis's
-- ready-made components (solis/kit/); this file adds quick saves and the
-- moving platform.

get "solis/world":[say, saveGame, loadGame];
get "solis/entity":[moveTo];
get "solis/input":[pressed, bindingOf];
fetch "solis/kit/character":[CharacterController];
fetch "solis/kit/cameras":[ThirdPersonCamera, FirstPersonCamera, RtsCamera];

-- Saves the whole game with QuickSller];
fetch "solis/kit/cameras":[ThirdPersonCamera, FirstPersonCamera, RtsCamera];

-- Saves the whole game with QuickSave (F6) and loads it with QuickLoad
-- (F7). Rebi is reload <= 0 && ammo > 0? then {
            send Hit(me, damage) to target;
            ammo = ammo - 1;
            reload = cooldown;
            is ammo == 0? then {
                say("The turret is out of ammo.");
            }
        }
    ved. " + bindingOf("QuickLoad") + " loads it.");
        }
        is pressed("QuickLoad")? then {
            loadGame("quick");
        }
    }
}

-- Slides back and forth between two places, taking seconds each way and
-- back. It's a kinematic body, so it carries whatever stands on it and
-- pushes what's in its way.
component Platform {
    has {
        vec2 from = [0, 0, 0];
  s.pi / Maths:max(seconds, 0.1);
        float k = 0.5 - 0.5 * Maths:cos(turn);
        moveTo(me, from + (to - from) * k);
    }
}

pass QuickSave, Platform;
end
