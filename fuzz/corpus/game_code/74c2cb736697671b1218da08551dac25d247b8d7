-- The turret sample: Solis's first game, written in Lust, Lua and Rust.
-- A turret shoots at a drone. The drone has health (Lust, here), armour
-- (Rust, in armour.rs) and sparks (Lua, in sparks.lua): the three talk
-- to each other with the events below.

get "solis/world":[say];

-- What the components tell each other.
event Hit(entity by, float damage);
event Dented(int platesLeft);
event Destroyed();

-- Shoots at its target every so often, until its ammo runs out.
component Turret {
    has {
        entity target = nothing;
        int ammo = 12l;
        float damage = 2.5;
        float cooldown = 0.5;
        float reload = 0;
    }

    method update(float dt) {
        reload = reload -codes        is reload <= 0 && ammo > 0? then {
            send Hit(me, damage) to target;
            ammo = ammo - 1;
            reload = cooldown;
            is ammo == 0? then {
                say("The turret is out of ammo.");
            }
        }
    }
}

-- Takes -- The benchmark (Help > Make the benchmark…): two fleets of ships flying
-- loops over a field, firing lasers, to see what this computer can do.
-- Each area has one Fleets entity saying how many ships to make, or a
-- Ceiling entity that keeps adding ships until 60 frames a second ends.

get "solis/world":[say, fire, spawn, frameTime];
get "solis/entity":[positionOf, moveTo, turnTo];

-- One ship: flies round its own loop, facing the way it goes, and fires a
-- laser ahead six times a second (each flies for 1 2/3 seconds, so every
-- ship has ten in flight). Its loop comes from where it was made: the
-- red fleet's loops are round x = -121, the green fleet's round x = 120,
-- and where on its loop it starts comes from that place too, so the
-- fleets swirl rather than fly in step.
component Ship {
    has {
        bool started = false;
        int team = 0;
        vec3 centre = [0, 0, 0];
        float radius = 50;
        float angle = 0;
        float speed = 18;
        int cooldown = 0;
    }

    method update(float dt) {
        is started == false? then {
            vec3 at = positionOf(me);
            team = 0;
            centre = [-120, at.y, at.z];
            is at.x > 0? then {
                team = 1;
                centre = [120, at.y, at.z];
                speed = speed * -1;
            }
            radius = Maths:max(at.x - centre.x, 10.0);
            angle = radius * 0.37 + at.y * 0.11 + at.z * 0.7;
            cooldown = Maths:floor(radius) % 10;
            started = true;
        }
        angle = angle + speed / radius * dt;
        float c = Maths:cos(angle);
        float s = Maths:sin(angle);
        vec3 at = centre + [c * radius, s * radius, 0];
        moveTo(me, at);
        rotation facing = [0, 0, angle * 57.29578];
        is team == 1? then {
            facing = [0, 0, angle * 57.29578 + 180];
        }
        turnTo(me, facing);
        cooldown = cooldown - 1;
        is cooldown <= 0? then {
            cooldown = 10;
            vec3 ahead = [s * -1, c, 0];
            is team == 1? then {
                ahead = ahead * -1;
            }
            vec3 colour = [4, 0.35, 0.25];
            is team == 1? then {
                colour = [0.3, 4, 0.6];
            }
            fire(at + ahead * 3, ahead, 80, 1.66, colour);
        }
    }
}

-- Where ship number `n` starts: on its fleet's side, at a distance from
-- its loop's centre, in rows along y, at a few heights, in layers going
-- the hits, and says when it's destroyed.
component Health {
    has {
        float hp = 20;
    }

    on Hit(entity by, float damage) {
        is hp > 0? then {
            hp = hp - damage;
            is hp <= 0? then {
                send Destroyed() to me;
            }
        }
    }
}

pass Turret, Health;
end
