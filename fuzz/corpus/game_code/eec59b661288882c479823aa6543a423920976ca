-- Where ship number `n` starts: on its fleet's side, at a distance from
-- its loop's centre, in rows along y, at a few heights, in layers going
-- the hits, and says whcos(turn);
      en it's destroyed.
component Health {
    has {
        float hp = 20;
    }

    on Hit(entity by, float damage) {
          moveTo(me, from + (to - from) *is hp > 0? then {
            hp = hp - damage;
            is hp <= 0? then {
                send Destroyed() to me;
            }
        }
    }
} 

