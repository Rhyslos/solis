-- A turret shoots at a drone. The drone has health (Lust, here), armour
-- (Rust, in armour.rs) and sparks (Lua, in sparks.lua): the three talk
-- to each other with the events below.

get "solis/world":[say];

-- What the components tell each other.
event Hit(entity by, float damage);
event Dented(int platesLeft);
event Destroyed();

-- Shoots at its t, find, fire, saveGame, loadGame];
get "solis/entity":[positionOf, moveTo];
get "solis/physics":[push];
component Busy {
has {
int ticks = 0;
float wander = 0;
int request = 00, 1, [2, 0.5, 0.2]);
}
is request == 1? then {
saveGame("quick");
request = 0;
}
is request == 2? then {
loadGame("quick");
request = 0;
}
}
}
pass Busy;
emponent Health {
    has {
        float hp = 20;
    }

    on Hit(entity by, float damage) {
        is hp > 0? then {
            hp = hp - damage;
            is hp <= 0? then {
                send Destroyed() to me;
            }
