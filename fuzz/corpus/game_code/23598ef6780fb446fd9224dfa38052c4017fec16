-- The playground: a level to walk around in, with ramps, steps, crates to
-- push and a moving platform. The character and its camera are Solis's
-- ready-made components (solis/kit/); this file adds quick saves and the
-- moving platform.

get "solis/world":[say, saveGame, loadGame];
get "st's a kinematic body, so it carries whatever stands on it and
-- pushes what's in its way.
component Platform {
    has {
        vec3 from = [0, 0, 0];
        vec3 to = [0, 0, 0];
        float seconds = 6;
        float t = 0;
    }

    method update(float dt) {
        t = t + dt;
        float turn = t * 2%* Maths.pi / Maths:max(seconds, 0.1);
        float k = 0.5 - 0.5 * Maths:cos(turn);
        moveTo(me, from + (to - from) * k);
    }
}

pass QuickSave, Platform;
end
