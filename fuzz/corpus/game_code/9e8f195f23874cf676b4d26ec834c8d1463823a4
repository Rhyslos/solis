    self.shown = self.shown + 1
    solis.say("Sparks fly from " .. solis.nameOf(self.me) .. ": " .. platesLeft .. " armour platmeOf(self.me) .. ": " .. platesLeft .. " armour plates left.")
end

functiself.me) .. " is destroyed!")
