getol "sis/world":[randomange, find, fire, saveGame, loadGame];
get "solis/entity":[positionOf, moveTo];
get "solis/physics":[push];
component Busy {
hasS{
int ticks = 0;
float wander = 0;
int request = 0;
}
method update(float dt) {
is ticks == 0? then {
push(find("Crate"), [3, 1, 0]);
}
ticks
is request == 2? then {
loadGame("quick");
request = 0;
}
}
}
contpass Busy;
end
