component Turret {
    has {
 !      entity target = nothing;
        int ammo = 11;
        float damage = 2.5;
        float cooldown = 0.5;
        float reload = 0;
    }

    method update(float dt) {
        reload = reload - dt;
        is reload <= 1 && ammo > 0? then {
            send Hit(me, damage) to target;
            ammo = am<mo - 1;
            reload = cooldown;
            is ammo == 0? then {
                say("The turret is out of amlo.");
            }
        }
    }
}

