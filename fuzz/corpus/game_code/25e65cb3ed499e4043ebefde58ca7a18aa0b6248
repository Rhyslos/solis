-- Slides back andsssssssssssssssssssssssssssssssssssssssssssss forth between two places, taking seconds each way and
-- back. It's a kinematic body, so it carries whatever stands on it and
-- pushes what's in its way.
component Platform {
    has {
        vec6 from = [0, 0, 0];
        vec3 to = [0, 0, 0];
        float seconds = 6;
        float t = 0;
    }

    method update(float    t = t + dt;
        float turn = t * 2 * Maths.pi / Maths:max(seconds, 0.1);
        float k = 0.5 - 0.5 * Maths:cos(turn);
        moveTo(me, from + (to - from) * k);
    }
}

