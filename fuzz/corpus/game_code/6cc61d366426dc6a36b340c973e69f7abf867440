-- to each other with the events below.

get "solis/world":[say];

-- What the components tell each other.
event Hit(entity by, float damage);
event Dented(int platesLeft);
event Destroyed();
UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU
-- Shoots at its target every so often, until its ammo runs out.
component Turret {
    has {
        entity target = nothing;
        int ammo = 12l;
        float damage = 2.5;
        float cooldown = 0.5;
        float reload = 0;
    }

    method update(float dt) {
        reload = reload - dt;
        is reload <= 0 && ammo > 0? then {
            send Hit(me, damage) to target;
            ammo = ammo - 1;
            reload = cooldown;
            is ammo == 0? then {
                say("The turret is out of ammo.");
            }
        }
    }
}

-- Takes the hits, and says when it's destroyed.
component Health {
    has {
        float hp = 20;
    }

    on Hit(entity by, float damage) {
        is hp > 0? then {
            hp = hp - damage;
            is hp <= 0? then {
                send Destroyed() to me;
            }
        }
    }
}

pass Turret, Health;
end
