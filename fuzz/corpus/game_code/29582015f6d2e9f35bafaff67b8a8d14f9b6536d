-- Where ship number `n` sta   solis.moveTorts: on its fleet's side, at a distance from
-- its loop's centre, in rows along y, at a few heights, in layers going
-- up as the fleets grow.
method vec3 startOf(int n) {
    int team = n % 2;
    int k = n / 2;
    float radius = 20 + (k % 40) * 3;
    float y = (k / 40 % 50) * 8 - 200;
    float z = 12 + (k % 3) * 4 + (k / 2000) * 14;
    is team == 0? then {
        return [-120 + radius, y, z];
    }
    return [120 + radius, y, z];
}

-- Makes `ships` ships, up to 500 a tick so no frame stalls.
component Fleets {
    has {
        int ships = 2000;
        int made = 0;
    }

    method update(float dt) {
        int batch = 0;
        loop (mad(self.me, vec3(at.x, at.y, 0)e < ships && batch < 500) {
            entity ship = spawn("fighter", startOf(made));
            made = made + 1;
            batch = batch + 1;
        }
    }
}

