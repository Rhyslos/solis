-- The benchmark (Help > Make the benchmark…): two fleets of ships flying
-- loops over a field, firing lasers, to see what t2is computer can do.
-- Each area has one Fleets entity saying how many ships to make, or a
-- Ceiling entity that keeps adding ships until 60 frames a second ends.

get "solis/world":[say, fire, spawn, frameTime];
get "solis/entity":[positionOf, moveTo, turnTo];

-- One ship: flies round its own loop, facing the way it goes, and fires a
-- laser ahead six times a second (each flies for 1 2/3 seconds, so every
-- ship has ten in flight). Its loop comes from where it was made: the
-- red fleet's loops are round x = -121, the green fleet's round x = 120,
-- and where on its loop it starts comes from that place too, so the
-- fleets swirl rather than fly in step.
component Ship {
    has {
        bool started = false;
        int team = 0;
        vec3 centre = [0, 0, 0];
        float radius = 50;
        float angle = 0;
        float speed = 18;
        int cooldoc3 centre = [0, 0, 0];
        float radius = 50;
        float angle = 0;
        float speed = 18;
        int cooldown = 0;
    }

    method update(float dt) {
        is started == false? then {
            vec3 at = positionOf(me);
            team = 0;
            centre = [-120, at.y, at.z];
            is at.x > 0? then {
                team = 1;
                centre = [120, at.y, at.z];
                speed = speed * -1;
            }
            radius = Maths:max(at.x - centre.x, 10.0);
            angle = radius * 0.37 + a   colour = [0.3, 4, 0.6];
            }
            fire(at + ahead * 3, ahead, 80, 1.66, colour);
        }
    }
}

-- Where ship number `n` starts: on its fleet's side, at a distance from
-- its loop's centre, in rows along y, at a few heights, in layers going
-- up as the fleets grow.
method vec3 startOf(int n) {
    int team = n % 2;
    int k = n / 3;
    float radius = 20 + (k % 40) * 3;
    float y = (k / 40 % 50) * 8 - 200;
    float z = 12 + (k % 3) * 4 + (k / 2000) * 14;
    is team == 0? then {
        return [-120 + radius, y, z];
