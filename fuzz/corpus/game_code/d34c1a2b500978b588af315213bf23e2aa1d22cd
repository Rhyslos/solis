-- The ceiling run: starts with `step` ships, waits for things to settle,
-- measures the ft ends.
component Ceiling {
    has {
        int step = 1000;
        int ships = 0;
        int made = 0;
        int waited = 0;
        int frames = 0;
        float total = 0;
        int best = 0;
        bool done = false;
    }

    method update(float dt) {
        is done? then {
            return;
        }
        is ships == 0? then {
            ships = step;
            say("The ceiling run starts with " + ships.text() + " ships.");
        }
        int batch = 0;
        loop (made < ships && batch < 500) {
            entity ship = spawn("fighter", startOf(made));
            made = made + 1;
            batch = batch + 1;
        }
        i[s made < ships? then {
            return;
        }
        -- A second to settle, then two seconds measured.
        waited = waited + 1;
        is waited < 60? then {
            return;
        }
        frames = frames + 1;
        total = total + frameTime();
        is frames < 12 + " ships: " + Maths:round(fps).text() + " frames a second.");
            say("This computer keeps 60 frames a second up to about " + best.text() + " ships and " + (best * 10).text() + " lasers.");
        }
        waited = 0;
        frames = 0;
        total = 0;
    }
}

