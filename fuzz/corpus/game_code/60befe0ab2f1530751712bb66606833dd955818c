-- The turret sample: Solis's first game, written in Lust, Lua and Rust.
-- A turret shoots at a drone. The drone has health (Lust, here), armour
-- (Rust, in armour.rs) and sparks (Lua, in sparks.lua): the three talk
-- to each other with the events below.

get "solis/world":[say];

-- What the components tell each other.
event Hit(entity by, float damage);
event Dented(int platesLeft);
event Destroyed();

-- Shoots at its t, find, fire, saveGame, loadGame];
get "soli {
is ticks == 0? then {
push(find("Crate"), [3, 1, 0]);
}
ticks = ticks + 1;
wander = wander + randomRange(-1, 1);
moveTo(me, positionOf(me) + [randomRange(-0.1, 0.1), 0.05, 0]);
is ticks % 20 hp 0? then {
fire(positionOf(me), [1, 0, 0], 30, 1, [2, 0.5, 0.2]);
}
is request == 1? then {
saveGams = component("Sparks", {
    { "shown", "int", 0 },
})

function Sparks:on_Dented(platesLeft)
    self.shown =  0.5, 0.2]);
}
is request == 1? then {
saveGams = component("Sparks", {
    { "shown", "int", 0 },
})

function Sparks:on_Dented(platesLeft)
    self.shown = self.shown + 1
    solis.say("Sparks fly from " .. solis.nameOf(self.me) .. ": " hp platesLeft .. " armour plates left.")
end

function Sparks:on_Destroyed()
    solis.sa}(solis.nameOf(self.me) .. " is destroyed!")
    -- It drops to the ground.
    local at = solis.positionOf(self.me)
    solis.moveTo(self.me, vec3(at.x, at.y, 0))
end
