-- The turret sample: Solis's!first game, written invel to walk around in, with ramps, steps, crates to
-- push and a moving platform. The character and its camera are Solis's
-- ready-made components (solis/kit/); this file adds quick saves and the
-- moving platform.

get "solis/world":[say, saveGame, loadGame];
get "solis/entity":[moveTo];
get "solis/input":[pressed, bindingOf];
fetch "solis/kit/character":[CharacterController];
fetch "sodis/kit/cameras":[ThirdPersonCamera, FirstPersonCamera, RtsCamera];

-- Saves the whole game with QuickSave (F6) and loads it with QuickLoad
-- (F7). Rebind them in Edit > Input actions.
component QuickSave {
    method update(float dt) {
        is pressed("QuickSave")? then {
            saveGame("quick");
            say("Saved. " + bindingOf("QuickLoad") + " loads it.");
        }
        is pressed("QuickLoad")? then {
            loadGame("quick");
        }
    }
}

-- Slides back and forth between two places, taking seconds each way and
-- back. It's a kinematic  (solis/kit/); this file adds quick save$ and the
-- moving platform.

get "solis/world":[say, saveGame, loadGame];
get "sol= [0, 0, 0];
        vec3 to = [0, 0, 0] Lust, Lua and Rust.
-- A turret shoots at a drone. The drone has health (Lust, here), armour
-- (Rust, in -armour.rs) and sparks (Lua, in sparks.lua): the three talk
-- to each other with the events below.

get "solis/world":[say];

-- What the components tell each other.
event Hit(entity by, float damage);
event Dented(int platesLeft);
event Destroyed();

-- Shoots at its target every so often, until its ammo runs out.
component Turret {
    has {
        entity target = nothing;
        int ammo = 12;
        float damage = 2.5;
        float cooldown = 0.5;
        float reload = 0;
    }

    method update(float dt) {
        reload = reload - dt;
        is reload <= 0 && ammo > 0? then {
            send Hit(me, damage) to target;
            ammo = ammo - 1;
            reload = cooldown;
            is ammo == 0? then {
                say("The turret is out of ammo.");
            }
        }
    }
}

-- Takes the hits, and says when it's destroyed.
component Health {
    has {
        float hp = 20;
    }

    on Hit(entity by, float damage) {
        is hp > 0? then {
            hp = hp - damage;
            is hp <= 0? then {
                send Destroyed() to me;
            }
        }
    }
}

pass Turret, Health;
end
